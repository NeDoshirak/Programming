<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
        Title="Contacts" Height="250" Width="400" Padding="15">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <GroupBox Header="Edit Contact" Grid.Column="0" Margin="3">
            <StackPanel Margin="3">
                <TextBlock Text="Name:"/>
                <TextBox Text="Смирнов Юрий" Margin="3"/>

                <TextBlock Text="Phone Number:"/>
                <TextBox Text="+7-913-111-22-33" Margin="3"/>

                <TextBlock Text="Email:"/>
                <TextBox Text="yuri.smirnov@no.mail" Margin="3"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Read Contact" Grid.Column="1" Margin="3">
            <StackPanel Margin="3">
                <TextBlock>
                    <Bold>Name:</Bold> Смирнов Юрий
                </TextBlock>

                <TextBlock>
                    <Bold>Phone Number:</Bold> +7-913-111-22-33
                </TextBlock>

                <TextBlock>
                    <Bold>Email:</Bold> 
                    <TextBlock TextDecorations="Underline">yuri.smirnov@no.mail</TextBlock>
                </TextBlock>
                <Grid Height="100"/>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="3" Grid.Row="1">
            <Button Content="Save" Width="75" Height="25" Margin="3"/>
            <Button Content="Load" Width="75" Height="25" Margin="3"/>
        </StackPanel>
    </Grid>
</Window>
