<UserControl x:Class="View.Controls.ContactControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:View.Controls" xmlns:ViewModel="clr-namespace:View.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel Grid.Column="2" Background="White" Margin="8">
            <Grid Margin="3,15,15,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Width="100" Height="100" Margin="3" Grid.Column="0"/>
                <StackPanel Grid.Column="1" Margin="3">
                    <TextBlock Text="Name:" />
                    <TextBox Margin="3" Text="{Binding Name, Mode=TwoWay}" IsEnabled="{Binding IsEditing}"/>
                    <TextBlock Text="Phone Number:" />
                    <TextBox Margin="3" Text="{Binding PhoneNumber, Mode=TwoWay}" IsEnabled="{Binding IsEditing}"/>
                    <TextBlock Text="Email:" />
                    <TextBox  Margin="3" Text="{Binding Email, Mode=TwoWay}" IsEnabled="{Binding IsEditing}"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
